{
  "name": "stpetemusic",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "chrome >= 90",
    "firefox >= 90",
    "safari >= 14",
    "edge >= 90",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "dev": "docker-compose -f docker-compose.dev.yml up -d && npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run build --workspace=packages/db && npm run dev --workspace=apps/admin",
    "dev:cms": "npm run dev --workspace=apps/cms",
    "dev:services": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:stop": "docker-compose -f docker-compose.dev.yml down",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "reinstall": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/web/.next && npm install"
  },
  "devDependencies": {
    "react": "^19.2.8"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4",
    "@next/swc-linux-x64-gnu": "16.3.4",
    "@rolldown/binding-linux-x64-gnu": "1.2.7",
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
    "lightningcss-darwin-arm64": "^1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}

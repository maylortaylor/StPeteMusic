              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ from: 'hello@stpetemusic.live', to: [$env.ALERT_EMAIL || 'theburgmusic@gmail.com'], subject: $json.subject, text: $json.text }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 8000
        }

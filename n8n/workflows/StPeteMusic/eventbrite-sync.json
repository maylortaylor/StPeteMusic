            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "becbb3b2-0eba-4786-a3f5-6e2f4791e642",
      "name": "POST Sync Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -32,
        -112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-errors",
              "leftValue": "={{ $json.errors.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3d8aa468-c3dc-4ee9-a3c2-d477d05032aa",
      "name": "Has Errors?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        176,
        -112
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconsole.error('Eventbrite sync errors:', JSON.stringify(result.errors, null, 2));\nreturn [{ json: { message: `Sync completed with ${result.errors.length} error(s)`, ...result } }];\n"
      },
      "id": "fb199616-ec85-4afa-9112-2563e7b8d82c",
      "name": "Log Errors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -208
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconsole.log(`Eventbrite sync OK: synced=${result.synced} added=${result.added} updated=${result.updated}`);\nreturn [{ json: result }];\n"
      },
      "id": "2d3dcce7-4f06-425e-86d9-d71193107700",
      "name": "Log Success",

            { "name": "access_token", "value": "={{ $env.IG_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "a1f3c1a0-1000-4000-8000-000000000009",
      "name": "Publish IG Story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2060, 460],
      "continueOnFail": true
    }
  ],

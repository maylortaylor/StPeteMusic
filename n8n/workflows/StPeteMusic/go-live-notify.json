      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1800, 720],
      "webhookId": "a1f3c1a0-1000-4000-8000-000000000016"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v24.0/' + $env.IG_USER_ID + '/media_publish' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [

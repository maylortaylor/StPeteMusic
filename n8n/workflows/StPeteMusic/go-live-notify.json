      "name": "Wait for FB Story Processing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1280, 280],
      "webhookId": "a1f3c1a0-1000-4000-8000-000000000012"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v24.0/' + $env.FB_PAGE_ID + '/video_stories' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "video_id", "value": "={{ $json.id }}" },
            { "name": "link", "value": "={{ $('Resolve Asset and Link').item.json.linkUrl }}" },
            { "name": "access_token", "value": "={{ $env.FB_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "a1f3c1a0-1000-4000-8000-000000000006",
      "name": "Publish FB Story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1540, 280],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v24.0/' + $env.IG_USER_ID + '/media' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "media_type", "value": "STORIES" },
            { "name": "video_url", "value": "={{ $json.assetUrl }}" },
            { "name": "link", "value": "={{ $json.linkUrl }}" },
            { "name": "access_token", "value": "={{ $env.IG_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "a1f3c1a0-1000-4000-8000-000000000007",
      "name": "Create IG Story Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1020, 520],
      "continueOnFail": true
    },
    {
      "parameters": {
        "amount": 15
      },
      "id": "a1f3c1a0-1000-4000-8000-000000000008",
      "name": "Wait for IG Story Processing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1280, 520],
      "webhookId": "a1f3c1a0-1000-4000-8000-000000000008"
    },
    {
      "parameters": {
        "url": "={{ 'https://graph.facebook.com/v24.0/' + $('Create IG Story Container').item.json.id + '?fields=status_code,status&access_token=' + $env.IG_ACCESS_TOKEN }}",
        "options": {}
      },
      "id": "a1f3c1a0-1000-4000-8000-000000000013",
      "name": "Check IG Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1540, 520],
